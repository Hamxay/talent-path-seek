ENV=local

# PostgreSQL (synchronous SQLAlchemy + psycopg2)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/talent_path_seek
DB_ECHO=false

# JWT
# Use a long random value in production
JWT_SECRET_KEY=change-me-super-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI (Phase 5)
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Override only if Google retires the default. Examples: gemini-2.5-flash, gemini-2.0-flash, gemini-2.5-pro
GEMINI_MODEL=gemini-2.5-flash
